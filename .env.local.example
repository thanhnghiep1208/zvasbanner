GEMINI_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Optional: email that always gets admin role regardless of Clerk metadata.
# Prefer setting role via Clerk Dashboard → User → privateMetadata: {"role":"admin"}.
# ADMIN_EMAIL=

# Liên hệ cấp tài khoản hiện ở màn hình chưa đăng nhập (để trống = ẩn).
# Chỉ là giá trị mặc định: admin sửa ở /dashboard → Cài đặt (lưu bảng app_settings, cần DATABASE_URL).
CONTACT_EMAIL=
CONTACT_PHONE=

# Required for /api/track, /api/dashboard, /api/dashboard/users (Postgres analytics).
# DATABASE_URL='postgresql://user:pass@host:5432/dbname?sslmode=require'

# Flow canvas (lib/flags.ts, lib/flow-rollout.ts)
# FLOW_CANVAS = off | allowlist | rollout | on
FLOW_CANVAS=off
# Clerk userId luôn bật (allowlist, rollout), phân tách bằng dấu phẩy
FLOW_CANVAS_ALLOWLIST=
# rollout: % user được bật (0–100), chia theo bucket ổn định của userId – tăng dần, không ai bị mất canvas
FLOW_CANVAS_PERCENT=0
# Đổi để chia lại nhóm rollout (mặc định flow-canvas-v1)
FLOW_CANVAS_SALT=
# Luôn tắt (vd. user cần quay về form), thắng allowlist/rollout/on
FLOW_CANVAS_DENYLIST=
